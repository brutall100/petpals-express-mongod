# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Port for the local server (the app opens on http://localhost:3000)
PORT=3000

# MongoDB connection string: MongoDB Atlas → Connect → Drivers,
# or a local database: mongodb://127.0.0.1:27017
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the database that stores the "pets" collection
DB_NAME=petpals
